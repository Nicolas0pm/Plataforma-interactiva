# Copia este archivo como .env y completa con tus valores reales.

FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# En un servidor (Render, Cloud Run) no hay archivo: pega aquí el contenido del JSON
# (o en base64). Si está definida, tiene prioridad sobre FIREBASE_CREDENTIALS_PATH.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=tu-project-id
# Solo necesario cuando actives Realtime Database para la cola del ESP32:
FIREBASE_REALTIME_DB_URL=

# Dominios permitidos para CORS, separados por coma. Usa * solo en desarrollo
# (con * nunca se envían credenciales, ver app/config.py).
CORS_ORIGINS=*

# Puntos necesarios para desbloquear una recompensa física (RF05)
REWARD_THRESHOLD=100

# --- Autenticación ---
# Secreto para firmar los tokens de sesión (PIN de estudiantes). Genera uno
# fuerte en producción, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-cambiar-en-produccion
# Minutos antes de que expire una sesión inactiva (RNF-SEG-04)
JWT_PIN_EXP_MINUTOS=30
# "Pepper" adicional para el hash del PIN de los estudiantes
PIN_PEPPER=dev-pepper-cambiar-en-produccion
# Secreto compartido que debe enviar el ESP32 al confirmar una entrega
DEVICE_SHARED_SECRET=

# --- Correo (código para confirmar el correo de docentes y padres) ---
# Opción 1 (recomendada en Render): Brevo, https://www.brevo.com (gratis, 300 correos/día).
# Crea una API key en "SMTP & API" y verifica el remitente en "Senders".
BREVO_API_KEY=
# Opción 2: SMTP (p. ej. Gmail con una "contraseña de aplicación": smtp.gmail.com, 587).
# Ojo: el plan gratis de Render bloquea los puertos SMTP; ahí usa Brevo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
# Correo que aparece como remitente (debe estar verificado en Brevo, o ser el de SMTP).
EMAIL_REMITENTE=
EMAIL_REMITENTE_NOMBRE=¡Aprendamos inglés!
# Sin BREVO_API_KEY ni SMTP_HOST el correo no se envía: el código aparece en el log del servidor.

# --- Solo desarrollo ---
# true = usa una base de datos en memoria en vez de Firestore real, para poder
# correr y probar toda la API sin credenciales de Firebase. NUNCA en producción.
USE_FAKE_DB=false
