# Copia este archivo como .env y completa con tus valores reales.

# --- Base de datos (PostgreSQL en Neon) ---
# Neon → tu proyecto → Connect → copia la "connection string" (empieza por postgresql://).
# Ejemplo: postgresql://usuario:clave@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Dominios permitidos para CORS, separados por coma. Usa * solo en desarrollo
# (con * nunca se envían credenciales, ver app/config.py).
CORS_ORIGINS=*

# Puntos necesarios para desbloquear una recompensa física (RF05)
REWARD_THRESHOLD=100

# --- Autenticación ---
# Secreto para firmar los tokens de sesión (niños, docentes y padres). Genera uno
# fuerte en producción, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-cambiar-en-produccion
# Minutos que dura la sesión de un niño (RNF-SEG-04)
JWT_PIN_EXP_MINUTOS=30
# Minutos que dura la sesión de un docente o padre (480 = una jornada)
JWT_ADULTO_EXP_MINUTOS=480
# "Pepper" adicional para el hash del PIN de los estudiantes
PIN_PEPPER=dev-pepper-cambiar-en-produccion
# Secreto compartido que envía el ESP32 al pedir su cola de premios y confirmar entregas
DEVICE_SHARED_SECRET=

# --- Solo desarrollo ---
# true = usa una base SQLite en memoria (si DATABASE_URL está vacío) y un login de
# desarrollo sin contraseña, para correr y probar toda la API sin Neon. NUNCA en producción.
USE_FAKE_DB=false
