rules_version = '2';

// Reglas de Firestore.
// IMPORTANTE: la API (backend) usa el Admin SDK con una Service Account, que SIEMPRE
// se salta estas reglas. Estas reglas solo importan si en algún momento el frontend
// llega a leer/escribir Firestore directamente (hoy no lo hace: todo pasa por la API).
// Se dejan restrictivas por defecto como capa de seguridad extra.

service cloud.firestore {
  match /databases/{database}/documents {

    // Las funciones van dentro de este match para que `database` esté definido.
    function estaAutenticado() {
      return request.auth != null;
    }

    function esDocente() {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "docente";
    }

    function esAdmin() {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    // Nadie escribe directo desde el cliente; solo lectura autenticada para
    // docentes/admin como respaldo si algún día se necesita un dashboard sin pasar
    // por la API. Todo lo demás queda cerrado.
    match /usuarios/{id} {
      allow read: if esDocente() || esAdmin() || (estaAutenticado() && request.auth.uid == id);
      allow write: if false; // solo vía API con Admin SDK
    }

    match /actividades/{id} {
      allow read: if estaAutenticado();
      allow write: if false;
    }

    match /historial_actividades/{id} {
      allow read: if esDocente() || esAdmin();
      allow write: if false;
    }

    match /feedback/{id} {
      allow read: if esDocente() || esAdmin();
      allow write: if false;
    }

    match /historial_recompensas/{id} {
      allow read: if esDocente() || esAdmin();
      allow write: if false;
    }

    // RNF-AUD-08: los registros de auditoría solo los crea la API (Admin SDK);
    // nadie, ni siquiera un admin, puede editarlos o borrarlos desde el cliente.
    match /auditoria/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    match /intentos_pin/{codigo} {
      allow read: if false; // solo vía API con Admin SDK
      allow write: if false;
    }
  }
}
